@model FashionStore.Web.Models.ReturnRequestViewModel
@using Newtonsoft.Json
@using Newtonsoft.Json.Serialization
@{ ViewBag.Title = "Đổi / trả sản phẩm"; }
<div class="yody-account-shell">
    @Html.Partial("_CustomerNav")
    @Html.Partial("_CustomerMessages")
    <header class="yody-page-heading"><p class="eyebrow">YODY / HỖ TRỢ SAU MUA</p><h1>Đổi / trả sản phẩm</h1><p>Đơn <strong>@Model.OrderId</strong> · Đã nhận @Model.Options.DeliveredAt.ToString("dd/MM/yyyy") · Hạn gửi yêu cầu @Model.Options.Deadline.ToString("dd/MM/yyyy"). Chỉ đổi màu hoặc kích cỡ trong cùng sản phẩm đã mua. Nếu muốn mua thêm, bạn có thể quay lại trang chủ sau khi gửi yêu cầu.</p></header>
    <section class="yody-surface-card yody-form-card yody-form-card-wide">
    @using (Html.BeginForm("SendReturn", "Customer", FormMethod.Post, new { @class="yody-account-form", id="customer-return-form" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(false,"Vui lòng kiểm tra thông tin:",new{@class="customer-errors",role="alert"})
        <input type="hidden" name="requestId" value="@Model.RequestId" />
        <input type="hidden" name="orderId" value="@Model.OrderId" />
        <div class="yody-field"><label for="kind">Bạn muốn xử lý thế nào?</label><select id="kind" name="kind" class="filter-input"><option value="DOI_SAN_PHAM" selected="@(Model.Kind=="DOI_SAN_PHAM"?"selected":null)">Đổi sản phẩm — cùng mặt hàng</option><option value="HOAN_TIEN" selected="@(Model.Kind=="HOAN_TIEN"?"selected":null)">Trả sản phẩm, hoàn tiền</option></select></div>
        <div class="yody-field"><label for="sku">Sản phẩm đã mua cần đổi / trả</label><select class="filter-input" id="sku" name="sku" required>
        @foreach(var item in Model.Options.Items){<option value="@item.Sku" selected="@(item.Sku==Model.Sku?"selected":null)" disabled="@(item.RemainingQuantity==0?"disabled":null)">@item.Name · @item.Color · @item.Size</option>}
        </select></div>
        <div class="yody-field"><label for="quantity">Số lượng sản phẩm cũ gửi lại</label><input id="quantity" name="quantity" class="filter-input" type="number" min="1" step="1" value="@Model.Quantity" required /></div>
        <fieldset id="exchange-fields"><legend>Phân loại sản phẩm muốn đổi</legend><p id="return-product-name"></p>
            <div class="yody-form-grid"><div class="yody-field"><label for="return-color">Màu sắc</label><select id="return-color" class="filter-input"></select></div><div class="yody-field"><label for="return-size">Kích cỡ</label><select id="return-size" class="filter-input"></select></div></div>
            <input id="newSku" name="newSku" type="hidden" value="@Model.NewSku" />
            <p class="yody-checkout-helper">Mã phân loại đã chọn: <output id="return-selected-sku">@Model.NewSku</output> · <span id="return-stock"></span></p>
            <div class="yody-field"><label for="newQuantity">Số lượng sản phẩm</label><input id="newQuantity" name="newQuantity" type="number" class="filter-input return-fixed-quantity" min="1" step="1" value="@Model.Quantity" readonly aria-readonly="true" required /><small>Số lượng theo hàng gửi lại trong đơn gốc; không mua thêm trong yêu cầu đổi hàng.</small></div>
        </fieldset>
        <p id="return-form-warning" class="customer-errors" role="alert" style="display:none"></p>
        <fieldset><legend>Thông tin liên hệ và nhận hàng</legend><div class="yody-form-grid"><div class="yody-field"><label for="recipient">Người liên hệ / nhận hàng</label><input id="recipient" name="recipient" class="filter-input" maxlength="150" value="@Model.Recipient" required /></div><div class="yody-field"><label for="phone">Số điện thoại</label><input id="phone" name="phone" class="filter-input" inputmode="tel" pattern="0[0-9]{9,10}" value="@Model.Phone" required /></div></div><div class="yody-field"><label for="exchangeAddress">Địa chỉ nhận hàng đổi / liên hệ trả hàng (nếu có)</label><textarea id="exchangeAddress" name="exchangeAddress" class="filter-input" rows="2" maxlength="300">@Model.ExchangeAddress</textarea><small>Mặc định theo đơn gốc. Có thể đổi địa chỉ; để trống nếu trao đổi trực tiếp tại cửa hàng.</small></div></fieldset>
        <fieldset id="return-bank"><legend>Tài khoản nhận hoàn tiền (nếu phát sinh)</legend><p>Có thể nhập ngay hoặc bổ sung tại phiếu đổi/trả sau khi cửa hàng duyệt khoản hoàn.</p><div class="yody-field"><label for="accountHolder">Tên chủ tài khoản</label><input id="accountHolder" name="accountHolder" class="filter-input" maxlength="150" value="@Model.AccountHolder" /></div><div class="yody-form-grid"><div class="yody-field"><label for="accountNumber">Số tài khoản</label><input id="accountNumber" name="accountNumber" class="filter-input" inputmode="numeric" pattern="[0-9]{6,34}" maxlength="34" value="@Model.AccountNumber" /></div><div class="yody-field"><label for="bankName">Ngân hàng</label><input id="bankName" name="bankName" class="filter-input" maxlength="100" value="@Model.BankName" /></div></div></fieldset>
        <div class="yody-field"><label for="reason">Lý do đổi / trả và tình trạng sản phẩm</label><textarea id="reason" name="reason" class="filter-input" minlength="5" maxlength="500" rows="4" required>@Model.Reason</textarea></div>
        <div class="yody-actions"><button id="return-submit" class="mn-btn mn-btn-primary" type="submit" disabled>GỬI YÊU CẦU</button><a class="yody-text-link" href="@Url.Action("Details","Orders",new{id=Model.OrderId})">Quay lại đơn hàng</a></div>
        <noscript><p class="customer-errors">Vui lòng bật JavaScript để chọn màu, kích cỡ và kiểm tra số lượng đổi.</p></noscript>
        <script type="application/json" id="customer-return-options">@Html.Raw(JsonConvert.SerializeObject(Model.Options,new JsonSerializerSettings{ContractResolver=new CamelCasePropertyNamesContractResolver(),StringEscapeHandling=StringEscapeHandling.EscapeHtml}))</script>
    }
    </section>
</div>
@section scripts { <script src="@Url.Content("~/Scripts/customer-returns.js")?v=20261105-2"></script> }
