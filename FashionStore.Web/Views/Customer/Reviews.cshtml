@model Newtonsoft.Json.Linq.JArray
@using FashionStore.Web.Helpers
@{ ViewBag.Title = "Đánh giá sản phẩm"; var reviewOrders=ViewBag.ReviewOrders as Newtonsoft.Json.Linq.JArray ?? new Newtonsoft.Json.Linq.JArray(); var myReviews=ViewBag.MyReviews as Newtonsoft.Json.Linq.JArray ?? new Newtonsoft.Json.Linq.JArray(); var requestedOrder=ViewBag.ReviewOrderId as string; }
<div class="yody-account-shell">
    @Html.Partial("_CustomerNav")
    @Html.Partial("_CustomerMessages")
    <header class="yody-page-heading"><p class="eyebrow">YODY / CẢM NHẬN KHÁCH HÀNG</p><h1>Đánh giá sản phẩm</h1><p>Chỉ khách đã mua, nhận hàng thành công và thanh toán mới được viết đánh giá. Nhận xét hợp lệ sẽ hiển thị ngay sau khi gửi.</p><a class="yody-text-link" href="@Url.Action("Details", "Product", new { id = ViewBag.ProductId })">← Quay lại chi tiết sản phẩm</a></header>
    <div class="yody-review-layout">
        <section class="yody-review-list" aria-label="Danh sách đánh giá">
            @if(User.Identity.IsAuthenticated && ViewBag.MyReviewsError!=null){<p class="customer-errors" role="alert">@ViewBag.MyReviewsError</p>}
            @if(User.Identity.IsAuthenticated && myReviews.Count>0){
                <section class="yody-my-reviews" aria-labelledby="my-reviews-heading">
                    <h2 id="my-reviews-heading" class="yody-section-subtitle">Đánh giá của bạn</h2>
                    <p class="yody-muted">Các nhận xét bạn đã gửi về sản phẩm này.</p>
                    @foreach(var review in myReviews){
                        var reviewStatus=(string)review["TrangThai"];
                        var statusText=reviewStatus=="HIEN_THI"?"Đã hiển thị":reviewStatus=="TU_CHOI"?"Đã ẩn":"Chưa hiển thị";
                        var statusClass=reviewStatus=="HIEN_THI"?"is-published":reviewStatus=="TU_CHOI"?"is-rejected":"is-pending";
                        <article class="yody-surface-card yody-review-card yody-own-review">
                            <div class="yody-review-status-row"><p class="review-stars" aria-label="@review["SoSao"] trên 5 sao">@review["SoSao"] / 5 ★</p><span class="yody-review-status @statusClass">@statusText</span></div>
                            <p class="review-author"><strong>@((string)review["TenHienThi"]??"Bạn")</strong></p>
                            <p class="yody-muted">Đơn <a href="@Url.Action("Details","Orders",new{id=(string)review["SoHD"]})">@review["SoHD"]</a> · @CustomerViewHelper.VietnamDate((DateTime)review["NgayDanhGia"],"dd/MM/yyyy HH:mm")</p>
                            <p class="review-body">@review["NoiDung"]</p>
                        </article>
                    }
                </section>
            }
            <h2 id="review-list-heading" class="yody-section-subtitle">Đánh giá từ khách hàng</h2>
            @if (Model.Count == 0)
            {
                <div class="yody-empty-state"><h3>Chưa có đánh giá công khai</h3><p>Hãy chia sẻ trải nghiệm của bạn sau khi nhận sản phẩm.</p></div>
            }
            @foreach (var p in Model)
            {
                <article class="yody-surface-card yody-review-card">
                    <p class="review-stars" aria-label="@p["SoSao"] trên 5 sao">@p["SoSao"] / 5 ★</p>
                    <p class="review-author"><strong>@p["TenHienThi"]</strong><span class="yody-muted"> · @CustomerViewHelper.VietnamDate((DateTime)p["NgayDanhGia"],"dd/MM/yyyy")</span></p>
                    <p class="review-body">@p["NoiDung"]</p>
                </article>
            }
            @Html.Partial("_FeaturePaging", Model.Count>=myReviews.Count?Model:myReviews)
        </section>
        <aside class="yody-review-side">
            @if (User.Identity.IsAuthenticated && reviewOrders.Count>0)
            {
                <section class="yody-surface-card yody-review-form" aria-labelledby="review-form-heading">
                    <h2 id="review-form-heading">Chia sẻ trải nghiệm</h2>
                    <p>Chọn đơn đã giao hàng thành công của bạn. Mỗi sản phẩm trong một đơn chỉ được đánh giá một lần.</p>
                    @using (Html.BeginForm("Review", "Customer", FormMethod.Post, new { @class = "yody-account-form" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@ViewBag.ProductId" />
                        <div class="yody-field"><label for="orderId">Đơn đã giao hàng thành công</label><select class="filter-input" id="orderId" name="orderId" required>
                            <option value="">Chọn đơn đã nhận sản phẩm</option>
                            @foreach(var order in reviewOrders){
                                var eligibleId=(string)order["SoHD"];
                                if(String.Equals(eligibleId,requestedOrder,StringComparison.Ordinal)||reviewOrders.Count==1){<option value="@eligibleId" selected>@eligibleId</option>}
                                else{<option value="@eligibleId">@eligibleId</option>}
                            }
                        </select><small><a href="@Url.Action("Index", "Orders")">Xem đơn hàng của tôi →</a></small></div>
                        <div class="yody-field"><label for="stars">Đánh giá sao</label><select class="filter-input" id="stars" name="stars">
                            @for (var i = 5; i >= 1; i--)
                            {
                                <option value="@i">@i sao</option>
                            }
                        </select></div>
                        <div class="yody-field"><label for="body">Nhận xét của bạn</label><textarea class="filter-input" id="body" name="body" required maxlength="2000" rows="5"></textarea></div>
                        <button type="submit" class="mn-btn mn-btn-primary">GỬI ĐÁNH GIÁ</button>
                    }
                </section>
            }
            else if(User.Identity.IsAuthenticated)
            {
                <div class="yody-surface-card"><h2>@(ViewBag.ReviewEligibilityError!=null?"Chưa thể kiểm tra đơn hàng":myReviews.Count>0?"Bạn đã gửi đánh giá":"Chưa có đơn đủ điều kiện")</h2><p>@(ViewBag.ReviewEligibilityError ?? (myReviews.Count>0?"Nội dung đã gửi được hiển thị tại mục Đánh giá của bạn. Mỗi sản phẩm trong một đơn chỉ được đánh giá một lần.":"Bạn chỉ được đánh giá sản phẩm thuộc đơn của mình sau khi giao hàng thành công và thanh toán. Đơn chờ xác nhận, đang giao hoặc đã hủy chưa đủ điều kiện; đơn đã đánh giá sẽ không hiện lại."))</p><a class="mn-btn mn-btn-outline" href="@Url.Action("Index", "Orders")">XEM ĐƠN HÀNG CỦA TÔI</a></div>
            }
            else
            {
                <div class="yody-surface-card"><h2>Muốn chia sẻ trải nghiệm?</h2><p>Hãy đăng nhập để viết đánh giá từ đơn hàng của bạn.</p><a class="mn-btn mn-btn-primary" href="@Url.Action("Login", "Account", new { returnUrl = Request.RawUrl })">ĐĂNG NHẬP</a></div>
            }
        </aside>
    </div>
</div>
