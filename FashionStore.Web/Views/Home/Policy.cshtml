@{ViewBag.Title="Hỗ trợ mua sắm";}
<nav class="breadcrumbs"><a href="@Url.Action("Index","Home")">Trang chủ</a><span>/</span><span>Hỗ trợ</span></nav>
<article class="policy-page yody-info-page yody-policy-page"><div class="yody-policy-content">
@if((string)ViewBag.Policy=="shopping"){<p class="eyebrow">YODY / HỖ TRỢ</p><h1>Hướng dẫn mua hàng</h1><p>Tìm sản phẩm bằng tên, mã hoặc bộ lọc. Mở chi tiết để chọn đúng kích cỡ, màu sắc và số lượng còn hàng.</p><p>Đăng nhập, thêm sản phẩm vào giỏ, kiểm tra địa chỉ và chọn COD hoặc chuyển khoản. Nếu dùng mã ưu đãi, nhấn kiểm tra ưu đãi trước khi đặt hàng.</p><p>Sau khi đặt thành công, xem mã đơn tại Đơn hàng của tôi. Khi kết nối gián đoạn, kiểm tra lịch sử trước khi tạo đơn mới.</p>}
@if((string)ViewBag.Policy=="shipping"){<p class="eyebrow">YODY / HỖ TRỢ</p><h1>Thông tin giao hàng</h1><p>Địa chỉ và số điện thoại được dùng để xử lý giao nhận. Bạn có thể chọn địa chỉ đã lưu hoặc nhập tại thanh toán.</p><p>Website hiện áp dụng phí giao hàng 0đ. Chưa cung cấp ước tính thời gian giao tự động hoặc theo dõi trực tiếp từ đơn vị vận chuyển.</p><p>Theo dõi các trạng thái nội bộ tại chi tiết đơn hàng. Không có mã vận đơn khi cửa hàng chưa cung cấp.</p>}
@if((string)ViewBag.Policy=="payment"){<p class="eyebrow">YODY / HỖ TRỢ</p><h1>Chính sách thanh toán</h1><p>COD: thanh toán khi nhận hàng theo thông tin đơn được cửa hàng xác nhận.</p><p>Chuyển khoản: sử dụng đúng thông tin ngân hàng được hiển thị trong chi tiết đơn. Nếu chưa có thông tin, liên hệ cửa hàng trước khi chuyển. Nội dung chuyển khoản dùng mã đơn.</p><p>Chọn chuyển khoản không đồng nghĩa đã thanh toán. Cửa hàng xác minh thủ công; website chưa tích hợp cổng thanh toán tự động.</p>}
@if((string)ViewBag.Policy=="returns"){<p class="eyebrow">YODY / HỖ TRỢ</p><h1>Chính sách đổi trả</h1><p>Gửi yêu cầu trong 15 ngày tính từ mốc đã giao ghi nhận trong hệ thống, đối với đơn đã hoàn tất của tài khoản. Nếu thiếu mốc giao, liên hệ cửa hàng để xác minh.</p><p>Chọn sản phẩm, số lượng và mô tả tình trạng. Nếu đổi hàng, cung cấp SKU mới. Số lượng yêu cầu cộng dồn không vượt số lượng đã mua còn hợp lệ.</p><p>Yêu cầu gửi đi ở trạng thái chờ duyệt; không đồng nghĩa đã chấp nhận đổi, hoàn tiền hoặc giữ tồn sản phẩm đổi. Cửa hàng kiểm tra tình trạng và điều kiện trước khi xử lý.</p>}
@if((string)ViewBag.Policy=="privacy"){<p class="eyebrow">YODY / HỖ TRỢ</p><h1>Thông tin dữ liệu cá nhân</h1><p>Hồ sơ lưu tên, số điện thoại, email và địa chỉ để phục vụ tài khoản, đơn hàng và giao nhận. Bạn có thể cập nhật tại Tài khoản của tôi.</p><p>Lựa chọn nhận thông tin khuyến mãi được lưu trong hồ sơ. Điểm và lịch sử giao dịch được sử dụng để hiển thị quyền lợi thành viên.</p><p>Không chia sẻ mật khẩu hoặc liên kết khôi phục với người khác. Đăng xuất sau khi sử dụng thiết bị chung. Liên hệ cửa hàng nếu cần hỗ trợ dữ liệu tài khoản.</p>}
@if((string)ViewBag.Policy=="terms"){<p class="eyebrow">YODY / HỖ TRỢ</p><h1>Điều khoản sử dụng</h1><p>Cung cấp thông tin nhận hàng chính xác và kiểm tra giá, phân loại cùng số lượng trước khi đặt. Giá và tồn được hệ thống xác minh lại khi xử lý.</p><p>Chỉ gửi đánh giá cho sản phẩm trong đơn đã hoàn tất của bạn. Nội dung cần phản ánh trải nghiệm thực tế; đánh giá sẽ chờ cửa hàng duyệt.</p><p>Điểm thưởng, đổi trả, ưu đãi và trạng thái thanh toán tuân theo dữ liệu nghiệp vụ cửa hàng. Website chưa hỗ trợ mọi dịch vụ của một sàn thương mại điện tử.</p>}
@if((string)ViewBag.Policy=="faq"){<p class="eyebrow">YODY / HỖ TRỢ</p><h1>Câu hỏi thường gặp</h1><p>Vì sao sản phẩm trong giỏ thay đổi? Giá và tồn được kiểm tra theo dữ liệu hiện tại. Hãy cập nhật giỏ và chọn số lượng phù hợp.</p><p>Tôi có thể hủy đơn không? Nút hủy xuất hiện khi đơn chưa giao và trạng thái thanh toán cho phép. Hệ thống kiểm tra lại trước khi hủy. Đơn đã thanh toán cần cửa hàng hỗ trợ.</p><p>Vì sao chưa thấy đánh giá? Đánh giá mới ở trạng thái chờ duyệt. Vì sao chưa có điểm? Chỉ giao dịch đã được ghi nhận trong lịch sử điểm mới xuất hiện trên tài khoản.</p>}
<a class="mn-btn mn-btn-outline" href="@Url.Action("Contact","Home")">LIÊN HỆ CỬA HÀNG</a></div></article>