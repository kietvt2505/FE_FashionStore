@model FashionStore.Web.Models.ChangePasswordViewModel
@{ ViewBag.Title = "Đổi mật khẩu"; }
<div class="yody-account-shell">
    @Html.Partial("_CustomerNav")
    @Html.Partial("_CustomerMessages")
    <header class="yody-page-heading"><p class="eyebrow">YODY / BẢO MẬT</p><h1>Đổi mật khẩu</h1><p>Đặt mật khẩu mới để bảo vệ tài khoản và thông tin mua sắm.</p></header>
    <section class="yody-surface-card yody-form-card">
        @using (Html.BeginForm("Password", "Account", FormMethod.Post, new { @class = "yody-account-form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(false, "", new { @class = "customer-errors", role = "alert" })
            <div class="yody-field">@Html.LabelFor(m => m.CurrentPassword) @Html.PasswordFor(m => m.CurrentPassword, new { @class = "filter-input", autocomplete = "current-password", maxlength = "128" }) @Html.ValidationMessageFor(m => m.CurrentPassword)</div>
            <div class="yody-field">@Html.LabelFor(m => m.NewPassword) @Html.PasswordFor(m => m.NewPassword, new { @class = "filter-input", autocomplete = "new-password", maxlength = "128" }) @Html.ValidationMessageFor(m => m.NewPassword)</div>
            <div class="yody-field">@Html.LabelFor(m => m.ConfirmPassword) @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "filter-input", autocomplete = "new-password", maxlength = "128" }) @Html.ValidationMessageFor(m => m.ConfirmPassword)</div>
            <div class="yody-actions"><button class="mn-btn mn-btn-primary" type="submit">ĐỔI MẬT KHẨU</button><a class="yody-text-link" href="@Url.Action("Profile", "Account")">Quay lại hồ sơ</a></div>
        }
    </section>
</div>
