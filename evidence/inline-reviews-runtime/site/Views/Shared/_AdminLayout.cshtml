@{ var pageTitle = (ViewBag.Title ?? "Quản trị") + " | YODY Quản trị"; }
<!doctype html>
<html lang="vi"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex,nofollow" /><title>@pageTitle</title>
<link rel="icon" type="image/svg+xml" href="@Url.Content("~/Content/images/brand/yody-favicon.svg")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Content/images/brand/yody-favicon.svg")).Ticks" />
<link rel="stylesheet" href="@Url.Content("~/Content/admin.css")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Content/admin.css")).Ticks" /><link rel="stylesheet" href="@Url.Content("~/Content/navy-theme.css")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Content/navy-theme.css")).Ticks" />
<link rel="stylesheet" href="@Url.Content("~/Content/brand.css")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Content/brand.css")).Ticks" /></head>
<body class="admin-body">@RenderBody()</body></html>
