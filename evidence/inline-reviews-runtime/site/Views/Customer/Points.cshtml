@model Newtonsoft.Json.Linq.JArray
@using FashionStore.Web.Helpers
@{ ViewBag.Title = "Lịch sử điểm"; }
<div class="yody-account-shell">
    @Html.Partial("_CustomerNav")
    @Html.Partial("_CustomerMessages")
    <header class="yody-page-heading"><p class="eyebrow">YODY / QUYỀN LỢI THÀNH VIÊN</p><h1>Điểm thưởng &amp; thành viên</h1><p>Điểm và hạng hiện tại lấy từ hồ sơ đã được cửa hàng ghi nhận. Cứ mỗi 10.000đ giá trị hóa đơn được ghi nhận tương ứng 1 điểm, làm tròn xuống theo quy trình cửa hàng. Hệ thống hiện chưa có sổ lịch sử điểm đầy đủ; xem điều kiện lên hạng bên dưới.</p><a class="yody-text-link" href="@Url.Action("Index", "Customer")">Xem số dư và hạng hiện tại →</a></header>
    <section class="yody-surface-card yody-table-section" aria-labelledby="point-history-heading">
        <div class="yody-card-heading"><h2 id="point-history-heading">Lịch sử giao dịch điểm</h2></div>
        @if (Model.Count == 0)
        {
            <div class="yody-empty-state"><h3>Chưa có giao dịch điểm</h3><p>Giao dịch đã được ghi nhận sẽ xuất hiện tại đây.</p></div>
        }
        else
        {
            <div class="customer-table-wrap"><table class="customer-cart-table yody-data-table"><thead><tr><th>Thời điểm</th><th>Giao dịch</th><th>Điểm</th><th>Đơn hàng</th><th>Ghi chú</th></tr></thead><tbody>
            @foreach (var p in Model)
            {
                <tr><td data-label="Thời điểm">@CustomerViewHelper.VietnamDate((DateTime)p["ThoiDiem"])</td><td data-label="Giao dịch">@CustomerViewHelper.Status((string)p["LoaiGiaoDich"])</td><td data-label="Điểm"><strong>@p["SoDiemThayDoi"]</strong></td><td data-label="Đơn hàng">@p["SoHD"]</td><td data-label="Ghi chú">@p["GhiChu"]</td></tr>
            }
            </tbody></table></div>
        }
    </section>
    @Html.Partial("_FeaturePaging", Model)
    @Html.Partial("_MembershipRules")
</div>
